{
  "expo": {
    "name": "Tranzet",
    "slug": "tranzet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tranzet",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tranzet.shipping"
    },
    "android": {
      "package": "com.tranzet.shipping",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF3B1F"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF3B1F",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يحتاج ترانزيت الوصول لموقعك لتحديد نقاط الشحن والتتبع."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج ترانزيت الوصول لصورك لإرفاق إثبات التسليم.",
          "cameraPermission": "يحتاج ترانزيت استخدام الكاميرا لتصوير إثبات التسليم."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-logo.png",
          "color": "#FF3B1F"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce02d5b8-7d90-478e-9c87-e34f03fb0f60"
      }
    },
    "owner": "tasneemhazem27"
  }
}
